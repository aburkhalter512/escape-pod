{
  "extends": "./tsconfig.json",
  // TypeScript's `extends` replaces array-valued options like `exclude`
  // rather than merging them, so tsconfig.json's own Cloudflare-specific
  // exclusions (worker.ts, durableObject.ts, storage/**/*.ts, etc. — see
  // that file's comments) have to be repeated here too, not just the
  // test-file exclusion this file originally only needed.
  "exclude": [
    "src/**/*.test.ts",
    "src/worker.ts",
    "src/durableObject.ts",
    "src/honoApp.ts",
    "src/storage/**/*.ts",
    "src/routes/*.hono.ts",
    "src/discord/restWorkers*.ts",
    "src/crypto/tokenCryptoWorkers*.ts",
    "src/testUtils/fakeAppSqlStorage.ts"
  ]
}
