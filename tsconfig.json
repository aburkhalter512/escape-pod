{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "exclude": [
    "src/worker.ts",
    "src/durableObject.ts",
    "src/storage/**/*.ts",
    "src/routes/*.hono.ts",
    "src/discord/restWorkers*.ts",
    "src/crypto/tokenCryptoWorkers*.ts",
    "src/testUtils/fakeAppSqlStorage.ts",
    "src/**/*.workers.test.ts"
  ]
}
