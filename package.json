{
  "name": "escape-pod",
  "version": "0.1.0",
  "private": true,
  "description": "Discord bot + Interactions webhook. Owns durable state (organizers, guild subscriptions, pod rounds) and the Protect the Pod integration.",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "register-commands": "tsx scripts/register-commands.ts",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit",
    "typecheck:cloudflare": "tsc -p tsconfig.cloudflare.json --noEmit",
    "prisma:generate": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "deploy:cloudflare": "wrangler deploy",
    "dev:cloudflare": "wrangler dev"
  },
  "dependencies": {
    "@discordjs/rest": "^2.4.0",
    "@prisma/client": "^5.22.0",
    "discord-api-types": "^0.38.49",
    "discord-interactions": "^4.1.0",
    "hono": "^4.12.32",
    "prisma": "^5.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.0",
    "@cloudflare/workers-types": "^5.20260728.1",
    "@eslint/js": "^9.39.4",
    "@hono/zod-validator": "^0.9.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "undici": "6.27.0"
  },
  "engines": {
    "node": ">=20"
  }
}
